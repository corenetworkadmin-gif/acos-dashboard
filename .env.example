# Copy to .env.local, or run pnpm setup:engine to install the pinned CPU provider.
ACOS_ENGINE_BINARY=/absolute/path/to/llama-b11392/llama-completion
ACOS_MODEL_PATH=/absolute/path/to/qwen2.5-0.5b-instruct-q4_k_m.gguf
ACOS_MODEL_SHA256=74a4da8c9fdbcd15bd1f6d01d621410d31c6fc00986f5eb687824e7b93d7a9db
# Optional. Defaults to ~/.local/share/acos, loopback port 4317.
# ACOS_DATA_DIR=/absolute/private/path/acos
# ACOS_PORT=4317
# ACOS_DASHBOARD_PORT=8080 # pnpm start only
# Additional exact dashboard hostnames behind your own HTTPS reverse proxy:
# ACOS_ALLOWED_HOSTS=acos.example.test

# Optional resource policy. No GPU driver, CUDA, or external AI service is required.
# CPU is the only implemented isolated provider. auto currently selects CPU.
ACOS_COMPUTE_BACKEND=auto
# Optional upper bound; default derives from usable host threads, leaving one free where possible.
# ACOS_MAX_CPU_THREADS=4
# Required for non-reference models: measured working-RAM estimate in MiB.
# The pinned Qwen reference profile defaults to 2048 MiB; admission leaves host headroom.
# ACOS_MODEL_RAM_MB=2048
# Legacy ACOS_MODEL_MEMORY_MB remains a fallback alias for the RAM estimate.
# Separate virtual address-space ceiling; default includes model/thread/arena overhead.
# ACOS_ADDRESS_SPACE_MB=4096

# Explicit registered prompt adapter (required for non-reference model digests).
# ACOS_MODEL_ADAPTER=qwen-chatml # or llama3; GGUF tokenizer loading stays in llama.cpp
# Optional Linux cgroup v2 subtree owned by this user, with memory+pids delegated.
# ACOS_CGROUP_ROOT=/sys/fs/cgroup/acos-jobs
# ACOS_REQUIRE_CGROUP=1 # refuse inference when a delegated root is not configured
# Optional owner-only TOTP configuration file; see docs/lifecycle-trust.md.
# ACOS_MFA_FILE=/absolute/private/path/mfa.json
# Optional independently pinned Ed25519 public key: require signed extension manifests.
# ACOS_EXTENSION_PUBLIC_KEY_FILE=/absolute/trusted/extension-public.pem
# Optional Linux Vulkan execution (requires a Vulkan-enabled llama.cpp build and
# real target validation; the bundled reference binary remains CPU-only).
# ACOS_VULKAN_RENDER_NODE=/dev/dri/renderD128
# ACOS_MODEL_VRAM_MB=1024 # measured model requirement, never inferred from vendor
# Opt-in Linux desktop Secret Service key storage; migration verifies read-back
# before removing storage.key. Requires secret-tool and an unlocked session keyring.
# ACOS_STORAGE_KEY_PROVIDER=secret-service
